POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=getnet_support
POSTGRES_USER=getnet_app
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
POSTGRES_SSLMODE=disable
POSTGRES_CONNECT_TIMEOUT_SECONDS=5
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=5
POSTGRES_POOL_TIMEOUT_SECONDS=5
DEEPSEEK_API_KEY=replace-with-your-local-deepseek-key
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=30
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com/search
TAVILY_TIMEOUT_SECONDS=20
DJANGO_SECRET_KEY=replace-with-a-long-random-local-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
WEB_PORTAL_SECURE_COOKIES=false
AGENT_API_INTERNAL_URL=
AGENT_API_SERVICE_TOKEN=
AGENT_API_CONNECT_TIMEOUT_SECONDS=2
AGENT_API_READ_TIMEOUT_SECONDS=90
